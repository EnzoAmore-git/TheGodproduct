# Нормализация переводов строк: в репозитории всегда LF
* text=auto eol=lf

# Бинарные файлы не трогаем
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary

# SVG и шрифтовые/текстовые форматы — текстовые
*.svg   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.html  text eol=lf
